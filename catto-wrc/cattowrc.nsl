        "dashboard_display": "Optimized for feline visual spectrum (enhanced yellow/blue, reduced red)",
        "climate_control": "Advanced HVAC accounting for fur insulation",
        "whisker_clearance": "Minimum 15cm clearance zones around helmet area"
      },
      "helmet_modifications": {
        "ear_accommodation": "Flexible panels for ear movement",
        "acoustic_dampening": "Enhanced protection for sensitive feline hearing",
        "ventilation": "Increased airflow for temperature regulation",
        "visor_coating": "Anti-glare optimized for feline eye sensitivity"
      },
      "safety_harness": {
        "tail_routing": "Dedicated channel along seat spine",
        "quick_release": "Single-point release adapted for paw operation",
        "chest_padding": "Adjusted for feline torso proportions"
      }
    },
    "telemetry": {
      "data_channels": "150+ sensors monitoring all systems",
      "transmission_method": "Real-time to team via cellular/satellite",
      "driver_display_information": [
        "Hybrid charge level",
        "Tire pressure (all 4 corners)",
        "Differential settings",
        "Brake balance",
        "Lap/stage time delta",
        "Engine temperature",
        "Fuel level",
        "Gear position"
      ],
      "engineer_access": "Full telemetry analysis during service"
    },
    "cost_control_measures": {
      "hybrid_components": "Standard specification (Compact Dynamics unit)",
      "test_days_per_year": 42,
      "wind_tunnel_hours": "Limited allocation",
      "parts_homologation": "Major components fixed for regulation period",
      "engine_rebuild_interval": "Limited rebuilds per season"
    },
    "manufacturer_specific_cars": {
      "toyota_gr_yaris_rally1": {
        "base_model": "GR Yaris",
        "distinctive_features": "Matte black livery (2023-2025), Silver livery (2026)",
