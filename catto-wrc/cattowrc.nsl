        "eye_color": "Amber, blue, or heterochromia (one amber, one blue)",
        "build": "Large, athletic, powerful legs",
        "distinctive_features": "Water-resistant coat, distinctive 'cap' head pattern, heterochromia common",
        "tail": "Full plume, often colored"
      },
      "motorsport_advantages": [
        "Water-resistant coat handles rain exceptionally",
        "Powerful leg muscles for pedal control",
        "Heterochromia provides unique visual processing (Adrien's advantage)",
        "Athletic endurance for long rallies",
        "Social nature aids team dynamics"
      ],
      "motorsport_disadvantages": [
        "Large size can create cockpit fitting challenges",
        "White fur shows dirt/damage dramatically (optics)",
        "Swimming instinct occasionally distracts near water stages",
        "Plumed tail difficult to tuck ergonomically"
      ],
      "optimal_rally_conditions": "Wet weather, tarmac, technical stages requiring precision",
      "challenging_rally_conditions": "Dusty rallies (fur shows dirt), extremely hot climates",
      "cultural_notes": "Turkish Vans known for loving water - unique among cats. In CWRC, represent artistic/intellectual approach (Adrien) and joyful chaos (Grégoire)."
    }
  },
  "feline_biological_advantages_in_rallying": {
    "reflexes": {
      "speed_multiplier": "5x faster than human baseline",
      "application": "Split-second corrections, catching slides, obstacle avoidance",
      "measurement": "Visual stimulus to muscle response: ~60ms (human ~300ms)"
    },
    "night_vision": {
      "mechanism": "Tapetum lucidum (reflective layer behind retina)",
      "advantage": "6-8x better low-light vision than humans",
      "application": "Night stages, forest shadows, reduced headlight dependency",
      "trade_off": "Slightly reduced color perception in bright light"
    },
    "spatial_awareness": {
      "whisker_function": "Environmental feedback (air pressure, proximity, vibration)",
      "application": "Car width judgment, corner proximity sensing, aerodynamic feedback",
      "range": "Whiskers detect changes within 30cm radius"
    },
    "balance": {
      "inner_ear_structure": "Superior vestibular system",
      "tail_function": "Active counterbalance and proprioception",
      "application": "Roll/pitch sensing, jump landing prediction, weight transfer optimization"
    },
    "hearing": {
      "frequency_range_khz": "0.5-85 (human: 0.02-20)",
      "advantage": "Detect mechanical issues earlier (bearing wear, misfire, differential whine)",
      "disadvantage": "Engine noise requires extensive acoustic dampening in helmet"
    }
  },
  "feline_challenges_in_rallying": {
    "heat_sensitivity": {
      "issue": "Limited sweat glands (only paw pads), rely on panting for cooling",
      "affected_breeds": "Bombay (dark fur), Korat (tropical origin discomfort)",
      "mitigation": "Enhanced cockpit cooling, ice packs during service, hydration protocols"
    },
    "cold_sensitivity": {
      "issue": "Breeds from warm climates lack cold adaptation",
      "affected_breeds": "Korat (Thailand origin)",
      "mitigation": "Heated seats, heated driving shoes, thermal racing suits"
    },
    "sensory_overload": {
      "issue": "Sensitive hearing overwhelmed by engine noise",
      "affected_breeds": "All",
      "mitigation": "Advanced helmet acoustic dampening, custom ear protection"
    },
    "territorial_instincts": {
      "issue": "Natural competitive aggression requires professional control",
      "affected_breeds": "All",
      "mitigation": "Mental training, respect-based rally culture, post-race social bonding"
    },
    "predatory_distraction": {
      "issue": "Wildlife encounters trigger hunting instincts",
      "affected_breeds": "All",
      "mitigation": "Co-driver intervention, mental discipline training"
    }
  },
